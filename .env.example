# Booking backend baked into the build:
#   cloudflare -> real schedule via the Pages Functions in functions/api (D1 database)
#   demo       -> in-browser demo (data stays in the visitor's browser)
# Production builds default to "cloudflare" (.env.production); `npm run dev` uses the demo.
VITE_BOOKING_BACKEND=demo
# Optional: API origin when the site and the API live on different domains.
VITE_API_BASE=
